# Contact form — copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.

# Resend API key: https://resend.com/api-keys
# The key belongs to the account, not to a domain, so an existing key works for
# a new site — as long as it was created with "All domains" rather than scoped
# to one. Open the key in Resend to check.
RESEND_API_KEY=

# Where enquiries land. The receiving domain needs no setup at all — no DNS,
# no verification. Any mailbox you can read is fine.
CONTACT_TO_EMAIL=contact@sleepygiant.studio

# Who the mail comes from. This is the only address with a requirement: Resend
# will refuse a domain you have not verified under this same account.
#
# Checked against the live account: with onboarding@resend.dev as the sender,
# Resend refuses every recipient except the account owner's own address, with
#
#   403 "You can only send testing emails to your own email address
#        (hungmai@sleepygiant.studio). To send emails to other recipients,
#        please verify a domain at resend.com/domains, and change the `from`
#        address to an email using this domain."
#
# So reaching contact@sleepygiant.studio needs the domain verified and a sender
# on that domain. Both, not either — a verified domain with the resend.dev
# sender is still refused.
#
# Replies go to whoever filled in the form, not to this address.
CONTACT_FROM_EMAIL=Sleepy Giant Studio <noreply@sleepygiant.studio>
